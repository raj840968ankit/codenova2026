# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here



# URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Google Generative AI
GOOGLE_AI_KEY=your_google_generative_ai_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Email Configuration (Nodemailer)
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password_here

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Resend Email Service
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM==
